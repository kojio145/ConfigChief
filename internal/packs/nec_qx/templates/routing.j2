{% for fam in ['4', '6'] %}
{% for n in (t.bgp_neighbors if fam == '4' else t.bgp_ipv6_neighbors) %}
{% set what = 'BGP ネイバー ' ~ n.neighbor %}
{% if n.vrf %}
{{ fail(what ~ ': VRF の中のネイバーは、このパックでは書けません') }}
{% endif %}
 peer {{ n.neighbor }} as-number {{ n.remote_as | required(what ~ ' の相手 AS 番号') }}
{% if n.description %}
 peer {{ n.neighbor }} description {{ n.description }}
{% endif %}
{% if n.update_source %}
 peer {{ n.neighbor }} connect-interface {{ n.update_source }}
{% endif %}
{% if n.ebgp_multihop != '' %}
 peer {{ n.neighbor }} ebgp-max-hop {{ n.ebgp_multihop }}
{% endif %}
{% if n.password %}
 peer {{ n.neighbor }} password {{ n.password if n.password is startingwith('cipher ') else 'simple ' ~ n.password }}
{% endif %}
{% if fam == '4' and (n.keepalive != '' or n.holdtime != '') %}
 peer {{ n.neighbor }} timer keepalive {{ n.keepalive | required(what ~ ' の Keepalive（QX は、Keepalive と Hold を組で書きます）') }} hold {{ n.holdtime | required(what ~ ' の Hold') }}
{% endif %}
{% if n.enabled == false %}
 peer {{ n.neighbor }} ignore
{% endif %}
{% endfor %}
{% endfor %}
{% if t.bgp_neighbors or t.bgp_networks or t.bgp_redistribute %}
 #
 address-family ipv4 unicast
{% for x in t.bgp_networks %}
{% if x.vrf %}
{{ fail('BGP の広告経路 ' ~ x.prefix ~ ': VRF の中の BGP は、このパックでは書けません') }}
{% endif %}

{% endfor %}
{% for x in t.bgp_redistribute %}
{% if x.vrf %}
{{ fail('BGP の再配布 ' ~ x.source ~ ': VRF の中の BGP は、このパックでは書けません') }}
{% endif %}
{% if x.source in ['connected', 'static'] %}
  import-route {{ 'direct' if x.source == 'connected' else 'static' }}{{ ' med ' ~ x.metric if x.metric != '' else '' }}{{ ' route-policy ' ~ x.filter if x.filter else '' }}
{% else %}
  import-route {{ x.source }}{{ ' ' ~ x.process_id if x.process_id != '' and x.source == 'ospf' else '' }}{{ ' med ' ~ x.metric if x.metric != '' else '' }}{{ ' route-policy ' ~ x.filter if x.filter else '' }}
{% endif %}
{% endfor %}
{% for n in t.bgp_neighbors %}
{% if n.enabled != false %}
  peer {{ n.neighbor }} enable
{% endif %}
{% if n.next_hop_self == true %}
  peer {{ n.neighbor }} next-hop-local
{% endif %}
{% if n.default_originate == true %}
  peer {{ n.neighbor }} default-route-advertise
{% endif %}
{% if n.soft_reconfig_in == true %}
  peer {{ n.neighbor }} keep-all-routes
{% endif %}
{% if n.send_community == true %}
  peer {{ n.neighbor }} advertise-community
{% endif %}
{% if n.prefix_list_in %}
  peer {{ n.neighbor }} prefix-list {{ n.prefix_list_in }} import
{% endif %}
{% if n.prefix_list_out %}
  peer {{ n.neighbor }} prefix-list {{ n.prefix_list_out }} export
{% endif %}
{% if n.filter_in %}
  peer {{ n.neighbor }} route-policy {{ n.filter_in }} import
{% endif %}
{% if n.filter_out %}
  peer {{ n.neighbor }} route-policy {{ n.filter_out }} export
{% endif %}
{% endfor %}
{% endif %}

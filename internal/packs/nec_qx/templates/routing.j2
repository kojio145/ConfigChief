 router-id {{ p.router_id }}
{% endif %}
{% if p.keepalive != '' or p.holdtime != '' %}
 timer keepalive {{ p.keepalive | required('BGP の Keepalive（QX は、Keepalive と Hold を組で書きます）') }} hold {{ p.holdtime | required('BGP の Hold') }}
{% endif %}
{% if p.log_neighbor_changes != '' %}
{{ fail('BGP: 「ネイバーの変化を記録」は、このパックでは書けません（セルを空にしてください）') }}

{% set line.v = line.v ~ ' ' ~ side ~ ' ' ~ ('0' if tp[0] | length == 1 else '') ~ tp[0] ~ ':' ~ tp[1] ~ ' ' ~ (dp[1] | int) ~ '/' ~ (dp[2] | int) ~ '/' ~ dp[0] %}

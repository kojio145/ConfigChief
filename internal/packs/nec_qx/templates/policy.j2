{% set dt = r.start_date if side == 'from' else r.end_date %}
{% if tm or dt %}
{% set tp = tm | required(what ~ ' の時刻（日と組で書きます）') | split(':') %}
{% set dp = dt | required(what ~ ' の日（時刻と組で書きます）') | split('-') %}
{% if tp | length != 2 or dp | length != 3 %}
{{ fail(what ~ ': 時刻は 8:00、日は 2026-01-31 の形で書きます') }}

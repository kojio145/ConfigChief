{{ fail(what ~ ' の再配布の元 bgp は、NEC IX の RIPng では書けません（再配布できるのは static・connected・ospf です）') }}
{% endif %}
{% set b = namespace(asn='') %}
{% for x in t.bgp_processes %}
{% if not b.asn or x.vrf == '' %}
{% set b.asn = x.asn %}
{% endif %}
{% endfor %}
{% if not b.asn %}
{{ fail(what ~ ' の再配布の元 bgp は、BGP の表に行（AS 番号）が要ります') }}
{% endif %}
{% set src = 'bgp ' ~ b.asn %}
{% endif %}
{% if v6 %}
  redistribute {{ src }}{{ ' metric ' ~ d.metric if d.metric else '' }}{{ ' route-map ' ~ d.filter if d.filter else '' }}{{ ' tag ' ~ d.tag if d.tag != '' else '' }}
{% else %}
  redistribute {{ src }}{{ ' metric ' ~ d.metric if d.metric else '' }}{{ ' tag ' ~ d.tag if d.tag != '' else '' }}{{ ' route-map ' ~ d.filter if d.filter else '' }}
{% endif %}

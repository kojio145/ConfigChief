{% for d in t.rip_redistribute %}
{% if d.family == p.family %}
{% set src = d.source %}
{% if d.source == 'ospf' %}
{% set o = namespace(pid=d.process_id, n=0) %}
{% if not o.pid %}
{% for x in (t.ospfv3_processes if v6 else t.ospf_processes) %}
{% set o.pid = x.process_id %}
{% set o.n = o.n + 1 %}
{% endfor %}
{% if o.n != 1 %}
{{ fail(what ~ ' の再配布の元 ospf: 「OSPF のプロセス番号」が空で、プロセスが ' ~ o.n ~ ' つあります（番号を書いてください）') }}
{% endif %}
{% endif %}
{% set src = 'ospf ' ~ o.pid %}

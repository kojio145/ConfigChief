{% endif %}
{{ 'ipv6 router rip' if v6 else 'ip router rip' }}
{% if not v6 %}
{% if p.auto_summary == true %}
  auto-summary
{% endif %}
{% if p.default_metric %}
  default-metric {{ p.default_metric }}
{% endif %}
{% endif %}
{% if p.distance %}
  distance {{ p.distance }}
{% endif %}
{% if p.prefix_list_in %}
  distribute-list prefix {{ p.prefix_list_in }} in
{% endif %}
{% if p.prefix_list_out %}
  distribute-list prefix {{ p.prefix_list_out }} out
{% endif %}
{% if p.default_originate == true %}

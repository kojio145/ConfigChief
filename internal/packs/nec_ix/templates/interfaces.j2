{% elif n.type == 'pat_pool' %}
{% if n.pool_start != n.pool_end %}
{{ fail(what ~ ': 変換後アドレスの先頭と末尾が違います（NEC IX のポート変換（NAPT）は、1 つのアドレスへまとめます。先頭と末尾を同じアドレスにするか、種類を dynamic_pool にしてください）') }}

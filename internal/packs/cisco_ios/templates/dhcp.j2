{# The DHCP server. Syntax: cmdref 4.15 and 7.5. The addresses that are not
   handed out stand outside the pools; each goes to the pool whose network
   holds it. The device has no line for a range to hand out (it hands out the
   network without the excluded addresses): the range cells are not read. #}
{% for p in t.dhcp_pools %}
{% set what = 'DHCP ' ~ p.name %}
{% for x in p.excluded %}
{% set ends = x | split('-') %}
{% if ends | length != 2 or not ((ends[0] ~ '/32') is cidr) or not ((ends[1] ~ '/32') is cidr) %}
{{ fail(what ~ ' の配らないアドレス「' ~ x ~ '」は書けません（192.0.2.1-192.0.2.10 の形で書きます。1 つだけなら同じアドレスを 2 つ）') }}
{% elif not (ends[0] | in_net(p.network)) %}
{{ fail(what ~ ' の配らないアドレス ' ~ x ~ ' が、ネットワーク ' ~ p.network ~ ' の外にあります') }}
{% else %}
ip dhcp excluded-address {{ ends[0] }}{{ ' ' ~ ends[1] if ends[1] != ends[0] else '' }}
{% endif %}
{% endfor %}
{% endfor %}
{% for p in t.dhcp_pools %}
{% set what = 'DHCP ' ~ p.name %}
{% if ' ' in p.name %}
{{ fail(what ~ ' の名前に空白があります') }}
{% endif %}
ip dhcp pool {{ p.name }}
 network {{ p.network | ip }} {{ p.network | mask }}
{% if p.default_router %}
{% if p.default_routers_more | length > 7 %}
{{ fail(what ~ ' のデフォルトゲートウェイが ' ~ (p.default_routers_more | length + 1) ~ ' つあります（Cisco は 8 つまでです）') }}
{% endif %}
 default-router {{ p.default_router }}{{ ' ' ~ (p.default_routers_more | join(' ')) if p.default_routers_more else '' }}
{% elif p.default_routers_more %}
{{ fail(what ~ ': 「デフォルトゲートウェイ（2 つ目以降）」があるのに、「デフォルトゲートウェイ」が空です') }}
{% endif %}
{% if p.dns_servers %}
 dns-server {{ p.dns_servers | join(' ') }}
{% endif %}
{% if p.domain %}
 domain-name {{ p.domain }}
{% endif %}
{# Days, hours, minutes: "2d" is "lease 2", "36h" "lease 1 12", "90m"
   "lease 0 1 30". The device has no seconds. #}
{% if p.lease == 'infinite' %}
 lease infinite
{% elif p.lease %}
{% set n = p.lease[:-1] %}
{% set unit = {'d': 86400, 'h': 3600, 'm': 60, 's': 1} %}
{% if not (n is digits) or p.lease[-1:] not in ['d', 'h', 'm', 's'] or (n | int) == 0 %}
{{ fail(what ~ ' の貸し出し時間「' ~ p.lease ~ '」は書けません（2d、12h、90m の形か、infinite と書きます）') }}
{% else %}
{% set sec = (n | int) * unit[p.lease[-1:]] %}
{% set best = ((sec // 86400) ~ 'd') if sec % 86400 == 0 else (((sec // 3600) ~ 'h') if sec % 3600 == 0 else (((sec // 60) ~ 'm') if sec % 60 == 0 else (sec ~ 's'))) %}
{% if sec % 60 != 0 %}
{{ fail(what ~ ' の貸し出し時間「' ~ p.lease ~ '」は書けません（Cisco の貸し出し時間は分までです。分で割り切れる値にしてください）') }}
{% elif best != p.lease %}
{{ fail(what ~ ' の貸し出し時間「' ~ p.lease ~ '」は、割り切れるいちばん大きい単位（' ~ best ~ '）で書いてください') }}
{% elif sec % 86400 == 0 %}
 lease {{ sec // 86400 }}
{% elif sec % 3600 == 0 %}
 lease {{ sec // 86400 }} {{ (sec % 86400) // 3600 }}
{% else %}
 lease {{ sec // 86400 }} {{ (sec % 86400) // 3600 }} {{ (sec % 3600) // 60 }}
{% endif %}
{% endif %}
{% endif %}
!
{% endfor %}

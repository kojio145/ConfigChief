{# The device as a whole and its users. Syntax: cmdref 4.1 and 4.4. The type
   of a hashed secret is told by how the hash starts (README). #}
hostname {{ device.hostname }}
!
{% if device.enable_secret %}
{% if device.secret_form == 'hashed' %}
{% if device.enable_secret is startingwith('$1$') %}
enable secret 5 {{ device.enable_secret }}
{% elif device.enable_secret is startingwith('$8$') %}
enable secret 8 {{ device.enable_secret }}
{% elif device.enable_secret is startingwith('$9$') or device.enable_secret is startingwith('$14$') %}
enable secret 9 {{ device.enable_secret }}
{% else %}
{{ fail('特権パスワードのハッシュの種類が分かりません（$1$・$8$・$9$ で始まる値を書けます。別メーカーのハッシュは引き継げません）') }}
{% endif %}
{% else %}
enable secret 0 {{ device.enable_secret }}
{% endif %}
!
{% endif %}
{% if device.timezone %}
{% set tz = device.timezone | split(' ') %}
{% if tz | length != 2 %}
{{ fail('タイムゾーンは「名前 +時」の形で書きます（例 JST +9）。Cisco では名前が要ります') }}
{% endif %}
{% set off = tz[1] | split(':') %}
{% if not (off[0] is startingwith('+') or off[0] is startingwith('-')) %}
{{ fail('タイムゾーンの時差は + か - で始めます（例 JST +9）') }}
{% endif %}
clock timezone {{ tz[0] }} {{ off[0] | replace('+', '') }} {{ off[1] if off | length > 1 else '0' }}
!
{% endif %}
{# The services of the device (appendix A 3.26). The words after
   "datetime" stand in the order of the command reference. #}
{% for what in ['debug', 'log'] %}
{% set ts = device.debug_timestamp if what == 'debug' else device.log_timestamp %}
{% set opts = device.debug_timestamp_options if what == 'debug' else device.log_timestamp_options %}
{% if ts == 'time' %}
{{ fail('ログの時刻の付け方 time（時刻だけ）は Cisco にありません（datetime か uptime にしてください）') }}
{% elif ts == 'uptime' %}
{% if opts %}
{{ fail('時刻に足すもの（msec など）は、時刻の付け方が datetime のときだけ書けます') }}
{% endif %}
service timestamps {{ what }} uptime
{% elif ts == 'datetime' %}
service timestamps {{ what }} datetime{{ ' msec' if 'msec' in opts else '' }}{{ ' localtime' if 'localtime' in opts else '' }}{{ ' show-timezone' if 'show_timezone' in opts else '' }}{{ ' year' if 'year' in opts else '' }}
{% elif opts %}
{{ fail('時刻に足すもの（msec など）は、時刻の付け方を書いたときだけ書けます') }}
{% endif %}
{% endfor %}
{% if device.password_encryption == true %}
service password-encryption
{% elif device.password_encryption == false %}
no service password-encryption
{% endif %}
{% if device.debug_timestamp or device.log_timestamp or device.password_encryption != '' %}
!
{% endif %}
{% if device.domain_name %}
ip domain name {{ device.domain_name }}
{% endif %}
{% if device.name_servers_vrf and not device.name_servers %}
{{ fail('DNS サーバの VRF がありますが、DNS サーバがありません') }}
{% endif %}
{% for a in device.name_servers %}
ip name-server {{ 'vrf ' ~ device.name_servers_vrf ~ ' ' if device.name_servers_vrf else '' }}{{ a }}
{% endfor %}
{% if device.domain_name or device.name_servers %}
!
{% endif %}
{% for u in t.users %}
{% set priv = (u.privilege | lex('user_role')) if u.privilege in ['admin', 'operator'] else u.privilege %}
{% if priv and priv is not digits %}
{{ fail('ユーザ ' ~ u.name ~ ' の権限は admin か、0〜15 の数で書きます') }}
{% endif %}
{% if u.secret_form == 'hashed' and u.reversible == true %}
{{ fail('ユーザ ' ~ u.name ~ ' は「元に戻せる形で持つ」が有効ですが、パスワードがハッシュです（ハッシュは元に戻せません。平文を入れ直してください）') }}
{% elif u.secret_form == 'hashed' %}
{% if u.secret is startingwith('$1$') %}
username {{ u.name }}{{ ' privilege ' ~ priv if priv else '' }} secret 5 {{ u.secret }}
{% elif u.secret is startingwith('$8$') %}
username {{ u.name }}{{ ' privilege ' ~ priv if priv else '' }} secret 8 {{ u.secret }}
{% elif u.secret is startingwith('$9$') or u.secret is startingwith('$14$') %}
username {{ u.name }}{{ ' privilege ' ~ priv if priv else '' }} secret 9 {{ u.secret }}
{% else %}
{{ fail('ユーザ ' ~ u.name ~ ' のパスワードのハッシュの種類が分かりません（$1$・$8$・$9$ で始まる値を書けます。別メーカーのハッシュは引き継げません）') }}
{% endif %}
{% elif u.reversible == true %}
{# The device has to know the password itself (PPP CHAP): "password". #}
username {{ u.name }}{{ ' privilege ' ~ priv if priv else '' }} password {{ '7' if u.secret_form == 'encrypted' else '0' }} {{ u.secret | required('パスワード') }}
{% elif u.secret_form == 'encrypted' %}
{{ fail('ユーザ ' ~ u.name ~ ' のパスワードは暗号化した形（encrypted）ですが、「元に戻せる形で持つ」が有効ではありません（Cisco の暗号化した形は username … password 7 だけです。有効にするか、平文を入れ直してください）') }}
{% else %}
username {{ u.name }}{{ ' privilege ' ~ priv if priv else '' }} secret 0 {{ u.secret | required('パスワード') }}
{% endif %}
{% endfor %}
{% if t.users %}
!
{% endif %}

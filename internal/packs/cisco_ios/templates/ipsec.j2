{% endif %}
{% for r in rows %}
{% if (r.ike_version | string) == '2' %}
{% if v.two is none %}
{% set v.two = r %}
{% endif %}
{% elif v.one is none %}
{% set v.one = r %}
{% endif %}
{% endfor %}

{% for g in t.ipsec_settings %}
{% if g.aggressive_mode == false %}
crypto isakmp aggressive-mode disable
{% set gs.any = true %}
{% elif g.aggressive_mode == true %}
{{ fail('IPsec の全体設定の「アグレッシブモードを受け付ける」の「有効」は書けません（有効は、行が無いのと同じです。セルを空にしてください）') }}
{% endif %}
{% if g.invalid_spi_recovery == true %}
crypto isakmp invalid-spi-recovery
{% set gs.any = true %}
{% elif g.invalid_spi_recovery == false %}
{{ fail('IPsec の全体設定の「知らない SPI を受けたら IKE をつなぎ直す」の「無効」は書けません（無効は、行が無いのと同じです。セルを空にしてください）') }}
{% endif %}
{% if g.anti_replay == false %}
{% if g.replay_window != '' %}
{{ fail('IPsec の全体設定: 「再送攻撃の検出」が無効なのに、「再送攻撃の検出の窓」があります（どちらかを空にしてください）') }}
{% endif %}
crypto ipsec security-association replay disable
{% set gs.any = true %}
{% elif g.anti_replay == true %}
{{ fail('IPsec の全体設定の「再送攻撃の検出」の「有効」は書けません（有効は、行が無いのと同じです。セルを空にしてください）') }}
{% endif %}
{% if g.replay_window != '' %}
{% if (g.replay_window | string) not in ['64', '128', '256', '512', '1024'] %}
{{ fail('IPsec の全体設定の「再送攻撃の検出の窓」' ~ g.replay_window ~ ' は書けません（64・128・256・512・1024 のどれかです）') }}
{% endif %}
crypto ipsec security-association replay window-size {{ g.replay_window }}
{% set gs.any = true %}
{% endif %}
{% if g.idle_time != '' %}
crypto ipsec security-association idle-time {{ g.idle_time }}
{% set gs.any = true %}
{% endif %}
{% if g.df_bit %}
crypto ipsec df-bit {{ g.df_bit }}
{% set gs.any = true %}
{% endif %}

{% elif s.enabled == true %}
{{ fail('VLAN ' ~ s.vlans ~ ' の「スパニングツリーを使う」の「有効」は書けません（有効は、行が無いのと同じです。セルを空にしてください）') }}
{% endif %}
{% endfor %}
{# Port mirroring: a line for every source, one for the destination of a
   session. #}
{% for m in t.mirror_sessions %}
{% set any.line = true %}
{% for x in m.sources_both %}
monitor session {{ m.session }} source interface {{ x }}
{% endfor %}
{% for x in m.sources_rx %}
monitor session {{ m.session }} source interface {{ x }} rx
{% endfor %}
{% for x in m.sources_tx %}
monitor session {{ m.session }} source interface {{ x }} tx
{% endfor %}
{% if m.destination_if %}
monitor session {{ m.session }} destination interface {{ m.destination_if }}
{% endif %}
{% endfor %}

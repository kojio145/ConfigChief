   tree per VLAN they stand in the rows of the VLANs, and are not read here. #}
{% for g in t.l2_settings %}
{% if g.stp_mode == 'mst' %}
{% for one in [['stp_hello', 'hello-time'], ['stp_forward', 'forward-time'], ['stp_max_age', 'max-age']] %}
{% if g[one[0]] != '' %}
{% set any.line = true %}
spanning-tree mst {{ one[1] }} {{ g[one[0]] }}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}

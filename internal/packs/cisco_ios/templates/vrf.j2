{# VRFs. Syntax: cmdref 4.5. The newer form ("vrf definition") is written: it
   goes with "vrf forwarding" on the interfaces, and it carries IPv4 only
   with its "address-family ipv4" lines. #}
{% for v in t.vrfs %}
vrf definition {{ v.name }}
{% if v.description %}
 description {{ v.description }}
{% endif %}
{% if v.rd %}
 rd {{ v.rd }}
{% endif %}
{% for x in v.rt_export %}
 route-target export {{ x }}
{% endfor %}
{% for x in v.rt_import %}
 route-target import {{ x }}
{% endfor %}
 address-family ipv4
 exit-address-family
!
{% endfor %}

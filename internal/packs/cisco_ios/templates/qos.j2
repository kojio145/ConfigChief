{% endif %}
  priority level {{ r.priority_level }}
{% elif r.bandwidth_kbps != '' %}
  priority {{ r.bandwidth_kbps }}{{ burst }}
{% elif r.bandwidth_percent != '' %}
  priority percent {{ r.bandwidth_percent }}{{ burst }}
{% elif r.bandwidth_remaining != '' %}
{{ fail(what ~ ': 優先して送るクラスに「帯域（残りの %）」は書けません（kbps か % で上限を書きます）') }}
{% else %}
{% if burst %}
{{ fail(what ~ ': 優先のバーストは、帯域（上限）を書いたときだけ書けます') }}
{% endif %}
  priority
{% endif %}
{% else %}
{% if r.priority_level != '' %}
{{ fail(what ~ ': 「優先の段」は、「優先して送る」を有効にしたときだけ書けます') }}
{% endif %}
{% if r.bandwidth_kbps != '' %}
  bandwidth {{ r.bandwidth_kbps }}
{% elif r.bandwidth_percent != '' %}
  bandwidth percent {{ r.bandwidth_percent }}
{% elif r.bandwidth_remaining != '' %}
  bandwidth remaining percent {{ r.bandwidth_remaining }}
{% endif %}
{% endif %}
{% if r.shape_bps != '' %}
{% if r.shape_be != '' and r.shape_bc == '' %}
{{ fail(what ~ ': 超過バーストは、通常バーストを書いたときだけ書けます') }}
{% endif %}
  shape average {{ r.shape_bps }}{{ ' ' ~ r.shape_bc if r.shape_bc != '' else '' }}{{ ' ' ~ r.shape_be if r.shape_be != '' else '' }}
{% elif r.shape_bc != '' or r.shape_be != '' %}
{{ fail(what ~ ': 遅らせる側のバーストは、「上限・遅らせる」を書いたときだけ書けます') }}
{% endif %}
{% if r.police_bps != '' %}
{% if r.police_be != '' and r.police_bc == '' %}
{{ fail(what ~ ': 超過バーストは、通常バーストを書いたときだけ書けます') }}
{% endif %}
{% set ex = r.police_exceed if r.police_exceed else 'drop' %}
{% if ex in ['set_dscp', 'set_precedence'] %}
{% set ex = ('set-dscp-transmit ' if ex == 'set_dscp' else 'set-prec-transmit ') ~ (r.police_exceed_value | required(what ~ ' の「超えたときに付ける値」')) %}
{% elif r.police_exceed_value != '' %}
{{ fail(what ~ ': 「超えたときに付ける値」は、超えたときが set_dscp か set_precedence のときだけ書けます') }}
{% endif %}
  police cir {{ r.police_bps }}{{ ' bc ' ~ r.police_bc if r.police_bc != '' else '' }}{{ ' be ' ~ r.police_be if r.police_be != '' else '' }} conform-action transmit exceed-action {{ ex }}
{% elif r.police_bc != '' or r.police_be != '' or r.police_exceed or r.police_exceed_value != '' %}
{{ fail(what ~ ': 捨てる側のバースト・超えたときの動作は、「上限・捨てる」を書いたときだけ書けます') }}
{% endif %}
{% if r.set_dscp != '' and r.set_precedence != '' %}
{{ fail(what ~ ': 付ける DSCP と precedence は、どちらか 1 つだけ書きます') }}
{% elif r.set_dscp != '' %}
  set dscp {{ r.set_dscp }}
{% elif r.set_precedence != '' %}
  set precedence {{ r.set_precedence }}
{% endif %}
{% if r.queue_limit | length > 1 %}
{{ fail(what ~ ': キューの長さは 1 つだけ書けます（high・medium・normal・low の 4 つを並べる形は Cisco にありません）') }}
{% elif r.queue_limit %}
  queue-limit {{ r.queue_limit[0] }} packets
{% endif %}
{% if r.fair_queue %}
  fair-queue
{% endif %}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% endfor %}

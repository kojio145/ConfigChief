policy-map shape-{{ b.if_name | ifshort | replace('/', '-') | replace('.', '-') }}
 class class-default
  shape average {{ b.shape_bps }}{{ ' ' ~ b.shape_bc if b.shape_bc != '' else '' }}{{ ' ' ~ b.shape_be if b.shape_be != '' else '' }}

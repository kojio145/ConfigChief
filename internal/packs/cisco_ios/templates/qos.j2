{# QoS in the MQC form (stage M6). Syntax: cmdref 7.16.
   DSCP and precedence are written as numbers. The forms before MQC are read
   and never written. The rate of the whole interface is a parent policy
   "shape-<interface>" with the policy of the binding as its child (README).
   Where these lines stand in the text of a device is not known: they are
   written before the interfaces that name the policies. #}
{% for c in t.qos_classes %}
class-map match-{{ c.match | required('QoS のクラス ' ~ c.name ~ ' の合わせ方') }} {{ c.name }}
{% set k = namespace(i=0) %}
{% for m in t.qos_class_matches %}
{% if m.class == c.name %}
{% set what = 'QoS のクラス ' ~ c.name ~ ' の ' ~ m.seq ~ ' 番の条件' %}
{% set k.i = k.i + 1 %}
{% if m.seq != k.i * 10 %}
{{ fail(what ~ ': 順番が 10 刻みではありません（コンフィグには番号を書かず、上から順に書きます。順番を 10、20、30… に振り直してください。評価の順は変わりません）') }}
{% endif %}
{% set kinds = (1 if m.acl else 0) + (1 if m.dscp else 0) + (1 if m.precedence else 0) %}
{% if kinds > 1 %}
{{ fail(what ~ ': ACL・DSCP・precedence は 1 行に 1 つだけ書きます（行を分けてください）') }}
{% elif m.acl %}
 match access-group {{ '' if m.acl is digits else 'name ' }}{{ m.acl }}
{% elif m.dscp %}
{% if m.dscp | length > 8 %}
{{ fail(what ~ ': DSCP は 1 行に 8 つまでです（行を分けてください）') }}
{% endif %}
 match dscp {{ m.dscp | join(' ') }}
{% elif m.precedence %}
{% if m.precedence | length > 4 %}
{{ fail(what ~ ': precedence は 1 行に 4 つまでです（行を分けてください）') }}
{% endif %}
 match precedence {{ m.precedence | join(' ') }}
{% else %}
 match any
{% endif %}
{% endif %}
{% endfor %}
{% endfor %}
{% if t.qos_classes %}
!
{% endif %}
{% set seen = namespace(names=[]) %}
{% for first in t.qos_policies %}
{% if first.policy not in seen.names %}
{% set seen.names = seen.names + [first.policy] %}
policy-map {{ first.policy }}
{# The classes in their order; "default" is always the last one. #}
{% for pass in ['named', 'default'] %}
{% for r in t.qos_policies | sort(attribute='seq') %}
{% if r.policy == first.policy and (r.class == 'default') == (pass == 'default') %}
{% set what = 'QoS のポリシー ' ~ r.policy ~ ' のクラス ' ~ r.class %}
{% if r.class == 'local' %}
{{ fail(what ~ ': 機器自身が出す通信のクラス（local）は Cisco にありません（行を消すか、追加コンフィグに書いてください）') }}
{% endif %}
 class {{ 'class-default' if r.class == 'default' else r.class }}
{% set bw = (1 if r.bandwidth_kbps != '' else 0) + (1 if r.bandwidth_percent != '' else 0) + (1 if r.bandwidth_remaining != '' else 0) %}
{% if bw > 1 %}
{{ fail(what ~ ': 帯域（kbps・%・残りの %）は 1 つだけ書きます') }}
{% endif %}
{% if r.priority %}
{% set burst = ' ' ~ r.priority_burst if r.priority_burst != '' else '' %}
{% if r.priority_level != '' %}

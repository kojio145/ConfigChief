 prefix-delegation pool PD-{{ v.dhcp_server }} lifetime {{ v.dhcp_pd_valid }} {{ v.dhcp_pd_preferred }}
{% elif v.dhcp_pd_valid or v.dhcp_pd_valid == 0 or v.dhcp_pd_preferred or v.dhcp_pd_preferred == 0 %}
{{ fail(what ~ ': 「配るプレフィックスの有効時間」と「推奨時間」は、組で書きます') }}
{% else %}

{% elif v.dhcp_pd_length < v.dhcp_pd_pool | prefixlen | int %}
{{ fail(what ~ ': 「下流へ配る長さ」' ~ v.dhcp_pd_length ~ ' が、「下流へ配るプレフィックスの元」' ~ v.dhcp_pd_pool ~ ' の長さより短くなっています') }}
{% else %}
ipv6 local pool PD-{{ v.dhcp_server }} {{ v.dhcp_pd_pool }} {{ v.dhcp_pd_length }}
!
{% endif %}
{% endif %}
ipv6 dhcp pool {{ v.dhcp_server }}
{% for a in v.dhcp_address_prefix %}

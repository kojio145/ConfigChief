{% else %}
 dns-server {{ a }}
{% endif %}
{% endfor %}
{% if v.dhcp_domain %}
 domain-name {{ v.dhcp_domain }}
{% endif %}
{% for a in v.dhcp_ntp %}
{% if a == 'dhcp' %}

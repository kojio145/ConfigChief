{% if w.dhcp_server == v.dhcp_server and w.if_name < v.if_name %}
{% set n.first = false %}
{% endif %}
{% endfor %}
{% if n.first %}
{% set what = v.if_name ~ ' の DHCPv6 サーバ' %}
{% if v.dhcp_pd_from %}
{{ fail(what ~ ': 上流からもらったプレフィックスを下流へ配り直す設定（「上流からもらったプレフィックスから配る」）は、Cisco の公開資料に当たる書き方がありません。「下流へ配るプレフィックスの元」に決まったプレフィックスを書くか、追加コンフィグに書いてください') }}

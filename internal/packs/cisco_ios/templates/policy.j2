{# Access lists and prefix lists. Syntax: cmdref 4.9 and 7.1.
   A list is written in the named form, also when its name is a number
   ("ip access-list standard 10" is the same list as "access-list 10").
   The entries of a list numbered 10, 20, 30 ... are written without their
   numbers, as a device that does not keep the numbers shows them. Any other
   numbering is written out on every line, the remarks too (a remark with a
   number is for IOS XE 16.12 and later: README). #}
{# Time ranges (an entry names one). A date is "day month year". #}
{% set tr = namespace(seen=[]) %}
{% for r in t.time_ranges %}
{% if r.name not in tr.seen %}
{% set tr.seen = tr.seen + [r.name] %}
{% if ' ' in r.name %}
{{ fail('時間帯 ' ~ r.name ~ ' の名前に空白があります') }}
{% endif %}
time-range {{ r.name }}
{% set abs = namespace(n=0) %}
{% for k in t.time_ranges %}
{% if k.name == r.name %}
{% set what = '時間帯 ' ~ k.name ~ ' の ' ~ k.seq ~ ' 番' %}
{% if k.kind == 'absolute' %}
{% set abs.n = abs.n + 1 %}
{% if abs.n > 1 %}
{{ fail(what ~ ': 種類が absolute の行は、1 つの時間帯に 1 行までです') }}
{% endif %}
{% set line = namespace(v='') %}
{% for side in ['start', 'end'] %}
{% set d = k.start_date if side == 'start' else k.end_date %}
{% set tm = k.start_time if side == 'start' else k.end_time %}
{% if d %}
{% set parts = d | split('-') %}
{% if parts | length != 3 or not (parts[0] is digits) or not (parts[2] is digits) %}
{{ fail(what ~ ' の日「' ~ d ~ '」は書けません（2026-01-31 の形で書きます）') }}
{% else %}
{% set line.v = line.v ~ ' ' ~ side ~ ' ' ~ (tm | required(what ~ ' の時刻（日と組で書きます）')) ~ ' ' ~ (parts[2] | int) ~ ' ' ~ (parts[1] | lex('month')) ~ ' ' ~ parts[0] %}
{% endif %}
{% endif %}
{% endfor %}
{% if not line.v %}
{{ fail(what ~ ': 種類が absolute の行には、開始の日か終了の日が要ります') }}
{% endif %}
 absolute{{ line.v }}
{% else %}
 periodic {{ k.days | join(' ') | required(what ~ ' の曜日') }} {{ k.start_time | required(what ~ ' の開始の時刻') }} to{{ ' ' ~ (k.end_days | join(' ')) if k.end_days else '' }} {{ k.end_time | required(what ~ ' の終了の時刻') }}
{% endif %}
{% endif %}
{% endfor %}
!
{% endif %}
{% endfor %}
{% for a in t.acls %}
{% set kind = a.type | required('ACL ' ~ a.name ~ ' の種類') %}
ip access-list {{ kind }} {{ a.name }}
{% set n = namespace(i=0, plain=true) %}
{% for x in t.acl_entries %}
{% if x.acl == a.name %}
{% set n.i = n.i + 1 %}
{% if x.seq != n.i * 10 %}
{% set n.plain = false %}
{% endif %}
{% endif %}
{% endfor %}
{% for x in t.acl_entries %}
{% if x.acl == a.name %}
{% set no = '' if n.plain else x.seq ~ ' ' %}
{% set what = 'ACL ' ~ a.name ~ ' の ' ~ x.seq ~ ' 番' %}
{% if x.action == 'remark' %}
 {{ no }}remark {{ x.remark | required(what ~ 'の注記') }}
{% else %}
{# An address: any, a host, or a network with its wildcard. #}
{% set ad = namespace(s='', d='') %}
{% for side in ['s', 'd'] %}
{% set v = x.src if side == 's' else x.dst %}
{% set w = '' %}
{% if v == 'any' %}
{% set w = 'any' %}
{% elif v is cidr %}
{% set w = (v | ip) ~ ' ' ~ (v | wildcard) %}
{% elif v and (v ~ '/32') is cidr %}
{% set w = 'host ' ~ v %}
{% elif v %}
{{ fail(what ~ 'のアドレス「' ~ v ~ '」は書けません（any、192.0.2.1、192.0.2.0/24 の形で書きます）') }}
{% endif %}
{% if side == 's' %}
{% set ad.s = w %}
{% else %}
{% set ad.d = w %}
{% endif %}
{% endfor %}
{% if kind == 'standard' %}
{% for f in x.flags %}
{% if f != 'log' %}
{{ fail(what ~ 'の付加条件「' ~ f ~ '」は、標準 ACL には書けません（書けるのは log だけです）') }}
{% endif %}
{% endfor %}
{% if x.dscp != '' or x.precedence != '' or x.tos != '' or x.time_range or x.icmp_type or x.icmp_code != '' %}
{{ fail(what ~ ': DSCP・precedence・ToS・時間帯・ICMP の種類は、標準 ACL には書けません（種類を extended にしてください）') }}
{% endif %}
 {{ no }}{{ x.action }} {{ ad.s | required(what ~ 'の送信元') }}{{ ' log' if 'log' in x.flags else '' }}
{% else %}
{% set proto = x.protocol | required(what ~ 'のプロトコル') %}
{% if proto == 'ah' %}
{% set proto = 'ahp' %}
{% endif %}
{% if not (proto in ['ip', 'tcp', 'udp', 'icmp', 'gre', 'esp', 'ahp', 'ospf'] or proto is digits) %}
{{ fail(what ~ 'のプロトコル「' ~ x.protocol ~ '」は書けません（ip tcp udp icmp esp ah gre ospf か番号で書きます）') }}
{% endif %}
{# A port: 80, 1000-2000, >1023, <1024, !80. Numbers only. #}
{% set pt = namespace(s='', d='') %}
{% if proto in ['tcp', 'udp'] %}
{% for side in ['s', 'd'] %}
{% set p = x.src_port if side == 's' else x.dst_port %}
{% set w = '' %}
{% if p %}
{% set op = ' eq ' %}
{% if '-' in p %}
{% set op = ' range ' %}
{% elif '>' in p %}
{% set op = ' gt ' %}
{% elif '<' in p %}
{% set op = ' lt ' %}
{% elif '!' in p %}
{% set op = ' neq ' %}
{% endif %}
{% set nums = p | replace('>', '') | replace('<', '') | replace('!', '') | split('-') %}
{% for one in nums %}
{% if not (one is digits) %}
{{ fail(what ~ 'のポート「' ~ p ~ '」は書けません（80、1000-2000、>1023、<1024、!80 の形で、番号で書きます）') }}
{% endif %}
{% endfor %}
{% set w = op ~ (nums | join(' ')) %}
{% endif %}
{% if side == 's' %}
{% set pt.s = w %}
{% else %}
{% set pt.d = w %}
{% endif %}
{% endfor %}
{% endif %}
{# After the addresses: the ICMP type, the TCP flags, the marks of the
   packet, the time range, "fragments", and "log" last (nothing may follow
   it: command reference, "permit (IP)"). #}
{% set tail = namespace(v='', tcp=0) %}
{% if x.icmp_type %}
{% if proto != 'icmp' %}
{{ fail(what ~ 'の ICMP の種類は、プロトコルが icmp の行にだけ書けます') }}
{% endif %}
{% set tail.v = ' ' ~ x.icmp_type %}
{% endif %}
{% if x.icmp_code != '' %}
{% if not (x.icmp_type is digits) %}
{{ fail(what ~ 'の ICMP のコードは、ICMP の種類を番号で書いた行にだけ書けます') }}
{% endif %}
{% set tail.v = tail.v ~ ' ' ~ x.icmp_code %}
{% endif %}
{% for f in ['established', 'ack', 'fin', 'psh', 'rst', 'syn', 'urg'] %}
{% if f in x.flags %}
{% if proto != 'tcp' %}
{{ fail(what ~ 'の ' ~ f ~ ' は、プロトコルが tcp の行にだけ書けます') }}
{% endif %}
{% if f != 'established' %}
{% set tail.tcp = tail.tcp + 1 %}
{% endif %}
{% set tail.v = tail.v ~ ' ' ~ f %}
{% endif %}
{% endfor %}
{% if tail.tcp > 1 %}
{{ fail(what ~ ': TCP のフラグ（ack fin psh rst syn urg）は、1 行に 1 つだけ書けます（複数を並べたときの意味を、資料で確かめられていません。行を分けてください）') }}
{% endif %}
{% if x.dscp != '' and x.precedence != '' %}
{{ fail(what ~ ': DSCP と precedence は、どちらか 1 つだけ書きます') }}
{% elif x.dscp != '' %}
{% set tail.v = tail.v ~ ' dscp ' ~ x.dscp %}
{% elif x.precedence != '' %}
{% set tail.v = tail.v ~ ' precedence ' ~ x.precedence %}
{% endif %}
{% if x.tos != '' %}
{% if x.dscp != '' %}
{{ fail(what ~ ': DSCP と ToS は、どちらか 1 つだけ書きます') }}
{% endif %}
{% set tail.v = tail.v ~ ' tos ' ~ x.tos %}
{% endif %}
{% if x.time_range %}
{% set tail.v = tail.v ~ ' time-range ' ~ x.time_range %}
{% endif %}
{% if 'fragments' in x.flags %}
{% set tail.v = tail.v ~ ' fragments' %}
{% endif %}
{% if 'log' in x.flags and 'log_input' in x.flags %}
{{ fail(what ~ ': log と log_input は、どちらか 1 つだけ書きます') }}
{% elif 'log_input' in x.flags %}
{% set tail.v = tail.v ~ ' log-input' %}
{% elif 'log' in x.flags %}
{% set tail.v = tail.v ~ ' log' %}
{% endif %}
 {{ no }}{{ x.action }} {{ proto }} {{ ad.s | required(what ~ 'の送信元') }}{{ pt.s }} {{ ad.d | required(what ~ 'の宛先') }}{{ pt.d }}{{ tail.v }}
{% endif %}
{% endif %}
{% endif %}
{% endfor %}
!
{% endfor %}
{% for p in t.prefix_lists %}
ip prefix-list {{ p.name }} seq {{ p.seq }} {{ p.action }} {{ p.prefix }}{{ ' ge ' ~ p.ge if p.ge != '' else '' }}{{ ' le ' ~ p.le if p.le != '' else '' }}
{% endfor %}
{% if t.prefix_lists %}
